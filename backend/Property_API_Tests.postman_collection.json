{
  "info": {
    "_postman_id": "property-api-tests-001",
    "name": "Property API Tests",
    "description": "Comprehensive test suite for Property API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{seller_token}}"
      }
    ]
  },
  "item": [
    {
      "name": "1. Register Seller",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"seller@property.com\", \"password\": \"TestSeller123!\", \"name\": \"Property Seller\", \"phone\": \"+91-9876543210\", \"type\": \"seller\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Register - Status 201\", function () { pm.response.to.have.status(201); }); pm.test(\"Store seller ID\", function () { var jsonData = pm.response.json(); pm.environment.set('seller_id', jsonData.data._id); });"]
          }
        }
      ]
    },
    {
      "name": "2. Login Seller",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"seller@property.com\", \"password\": \"TestSeller123!\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Login - Status 200\", function () { pm.response.to.have.status(200); }); pm.test(\"Store token\", function () { var jsonData = pm.response.json(); pm.environment.set('seller_token', jsonData.token); });"]
          }
        }
      ]
    },
    {
      "name": "3. Create Property (With Images)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "title", "value": "Eco-Friendly Green Property", "type": "text"},
            {"key": "description", "value": "Beautiful green property with solar panels and organic farming", "type": "text"},
            {"key": "address", "value": "123 Green Street, Eco City, State 12345", "type": "text"},
            {"key": "boundaryCoordinates", "value": "[{\"lat\": 28.7041, \"lng\": 77.1025}, {\"lat\": 28.7050, \"lng\": 77.1035}]", "type": "text"},
            {"key": "areaInSqFt", "value": "5000", "type": "text"},
            {"key": "images", "type": "file", "src": []},
            {"key": "images", "type": "file", "src": []}
          ]
        },
        "url": {
          "raw": "http://localhost:3000/api/properties",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "properties"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Create - Status 201\", function () { pm.response.to.have.status(201); }); pm.test(\"Create - Success\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.success).to.eql(true); }); pm.test(\"Store property ID\", function () { var jsonData = pm.response.json(); pm.environment.set('property_id', jsonData.data.property._id); });"]
          }
        }
      ]
    },
