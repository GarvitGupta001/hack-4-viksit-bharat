  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "1. Register Seller Account",
          "event": [
            {
              "listen": "tests",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('seller_id', jsonData.data.user._id);",
                  "    pm.environment.set('seller_email', jsonData.data.user.email);",
                  "    console.log('✅ Seller registered:', jsonData.data.user.email);",
                  "}",
                  "",
                  "pm.test('Status code is 201', function() {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test('Response contains user data', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    pm.expect(jsonData.data.user.type).to.equal('seller');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller{{$timestamp}}@test.com\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"Test Seller\",\n  \"phone\": \"9876543210\",\n  \"type\": \"seller\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login Seller",
          "event": [
            {
              "listen": "tests",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('seller_token', jsonData.data.token);",
                  "    pm.environment.set('seller_id', jsonData.data.user._id);",
                  "    console.log('✅ Seller logged in, token set');",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response contains JWT token', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "    pm.expect(jsonData.data.token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{seller_email}}\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
