{
  "info": {
    "_postman_id": "carbon-coin-api-tests-001",
    "name": "Carbon Coin API Tests",
    "description": "Comprehensive test suite for Carbon Coin API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{seller_token}}"
      }
    ]
  },
  "item": [
    {
      "name": "1. Register Seller",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"seller@carbon.com\", \"password\": \"TestSeller123!\", \"name\": \"Carbon Seller\", \"phone\": \"+91-9876543210\", \"type\": \"seller\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Register - Status 201\", function () { pm.response.to.have.status(201); }); pm.test(\"Store seller ID\", function () { var jsonData = pm.response.json(); pm.environment.set('seller_id', jsonData.data._id); });"]
          }
        }
      ]
    },
    {
      "name": "2. Login Seller",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"seller@carbon.com\", \"password\": \"TestSeller123!\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Login - Status 200\", function () { pm.response.to.have.status(200); }); pm.test(\"Store token\", function () { var jsonData = pm.response.json(); pm.environment.set('seller_token', jsonData.token); });"]
          }
        }
      ]
    },
