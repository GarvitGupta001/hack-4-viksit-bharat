{
  "info": {
    "_postman_id": "company-api-tests-001",
    "name": "Company API Tests",
    "description": "Comprehensive test suite for Company API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{company_token}}"
      }
    ]
  },
  "item": [
    {
      "name": "1. Register Company Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"company@example.com\", \"password\": \"TestCompany123!\", \"name\": \"Tech Solutions Ltd\", \"phone\": \"+91-9876543210\", \"type\": \"company\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Register - Status 201\", function () { pm.response.to.have.status(201); }); pm.test(\"Register - Has success\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.success).to.eql(true); }); pm.test(\"Store company ID\", function () { var jsonData = pm.response.json(); pm.environment.set('company_id', jsonData.data._id); });"]
          }
        }
      ]
    },
    {
      "name": "2. Login Company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"company@example.com\", \"password\": \"TestCompany123!\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "tests",
          "script": {
            "exec": ["pm.test(\"Login - Status 200\", function () { pm.response.to.have.status(200); }); pm.test(\"Has token\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.token).to.be.a('string'); }); pm.test(\"Store token\", function () { var jsonData = pm.response.json(); pm.environment.set('company_token', jsonData.token); });"]
          }
        }
      ]
    },
